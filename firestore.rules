rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resourceData) {
      return signedIn() && resourceData.data.userId == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && userId == request.auth.uid;

      match /categories/{categoryId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
      }

      match /expenses/{expenseId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
      }

      match /income/{incomeId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
      }

      match /incomeSources/{sourceId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}